<mxfile host="app.diagrams.net"><diagram id="change6" name="Change 6: three models"><mxGraphModel dx="1170" dy="410" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1170" pageHeight="410" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="ens" value="Change 6: three models, trained separately" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#1F5FAD;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=14;fontStyle=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="230" y="20" width="640" height="300" as="geometry"/></mxCell><mxCell id="input" value='&lt;b&gt;Input utterance&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 11px" color="#000000"&gt;wake me up at nine am&lt;/font&gt;' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontSize=13;fontColor=#000000;spacing=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="140" width="170" height="66" as="geometry"/></mxCell><mxCell id="m_word" value='&lt;b&gt;word model&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 11px" color="#000000"&gt;word vectors only&lt;/font&gt;&lt;br&gt;&lt;font style="font-size: 11px" color="#000000"&gt;(same layout as Stage 1)&lt;/font&gt;' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontSize=13;fontColor=#000000;spacing=4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="255" y="66" width="280" height="66" as="geometry"/></mxCell><mxCell id="m_char" value='&lt;b&gt;char model&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 11px" color="#000000"&gt;word vectors + character CNN&lt;/font&gt;&lt;br&gt;&lt;font style="font-size: 11px" color="#000000"&gt;(Change 1)&lt;/font&gt;' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.